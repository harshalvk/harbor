# Server
PORT=8080
ENV=development

# Database
DATABASE_URL=postgres://postgres:postgres@localhost:5432/riverside_clone?sslmode=disable

# Auth (Clerk JWT verification)
# Clerk exposes a JWKS endpoint per instance — used to verify incoming session JWTs.
# e.g. https://<your-clerk-instance>.clerk.accounts.dev/.well-known/jwks.json
CLERK_JWKS_URL=

# CORS
WEB_ORIGIN=http://localhost:3000
