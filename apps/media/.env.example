PORT=4000

# The public IP mediasoup advertises to clients for ICE candidates.
# In dev this can be 127.0.0.1. In production this MUST be the real
# public IP of the box this runs on, or clients can't establish a
# WebRTC connection to it at all - this is the single most common
# "why won't my SFU connect" mistake.
MEDIASOUP_ANNOUNCED_IP=127.0.0.1

# UDP/TCP port range mediasoup opens for actual media (RTP) traffic.
# Needs to be a real range opened in your firewall/security group in
# production - this is why apps/media can't run on typical serverless
# hosting, which doesn't give you control over arbitrary UDP ports.
MEDIASOUP_MIN_PORT=40000
MEDIASOUP_MAX_PORT=40100